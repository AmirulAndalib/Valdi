# SECURITY: This script controls what internal code is mirrored to the public
# Valdi repos and what external contributions are pulled back in. Any change to
# this file — especially to origin_files/destination_files globs and their
# exclude lists — MUST be reviewed by AppSec (Snapchat/appsec) to ensure no
# proprietary code leaks out and no untrusted code lands internally.
#
# preserve_attribution() lives in attribution.bara.sky so it can be loaded
# in isolation (without a full origin/destination workflow) by
# test_attribution.py's Starlark fixtures.
load("attribution", "preserve_attribution")

internalRepoUrl = "git@github.sc-corp.net:Snapchat/mobile.git"
internalRepoRoot = "client/src/open_source/"

# Repository URLs
productionRepoUrl = "git@github.com:Snapchat/Valdi.git"
stagingRepoUrl = "git@github.com:Snapchat/valdi_staging.git"

# For AppSec reviewers:
#   1. Ensure that we are only copying files that are intended (within open_source folder)
#   2. Ensure that files that may contain proprietary information are omitted
internalRepoFiles = glob(["client/src/open_source/**"], # Only interested in files under src/open_source
        exclude=[
            # Don't include mirror scripts in the destination.
            "client/src/open_source/scripts/mirroring/**",
            # Exclude the original .gitignore and .gitattributes files.
            # We will use the copybara specific ones. See transformations below.
            "client/src/open_source/.gitignore",
            "client/src/open_source/.gitattributes",
            "client/src/open_source/README.md",
            "client/src/open_source/bzl/scripts/bazel_credential_helper.sh",
            "client/src/open_source/.bazelrc.internal",
            "**/OWNERS",
        ])

REPO_EXCLUDES = [
    # Exclude all of the files downloaded from GCS and checked-in with a script.
    "third-party/skia/libs/**",
    "third-party/jscore/libs/**",
    "third-party/v8/libs/**",
    "bin/clientsql/**",
    "bin/compiler/**",
    "bin/compiler_companion/**",
    "bin/valdi_compiler_toolbox/**",
    "bin/valdi_standalone/**",
    "**/OWNERS",
];

publicRepoUrlFiles = glob(["**"], exclude=REPO_EXCLUDES)

# Parameterized workflow function
def create_workflow(name, destination_url, destination_branch="main", mode="ITERATIVE", squash_message=None):
    if squash_message:
        message_transform = metadata.replace_message(squash_message)
    else:
        message_transform = core.dynamic_transform(preserve_attribution)
    return core.workflow(
        name = name,
        origin = git.origin(
            url = internalRepoUrl,
            ref = "master",
        ),
        destination = git.destination(
            url = destination_url,
            fetch = destination_branch,
            push = destination_branch,
        ),
        origin_files = internalRepoFiles,
        destination_files = publicRepoUrlFiles,
        authoring = authoring.pass_thru(default = "SnapCI <snapci@snapchat.com>"),
        transformations = [
            # Move the contents of client/src/open_source/ to the root of the destination.
            core.move(internalRepoRoot, ""),
            # Replace the original .gitignore and .gitattributes files with the copybara specific ones.
            core.move(".gitignore.copybara", ".gitignore", overwrite=True),
            core.move(".gitattributes.copybara", ".gitattributes", overwrite=True),
            core.move("README.copybara", "README.md", overwrite=True),
            core.move("bzl/additional_dependencies.bzl.copybara", "bzl/additional_dependencies.bzl", overwrite=True),
            core.move("bzl/open_source_archives.bzl.copybara", "bzl/open_source_archives.bzl", overwrite=True),
            core.replace(before = "INTERNAL_BUILD = True", after = "INTERNAL_BUILD = False", paths =  glob(["bzl/prebuilt_tools.bzl"])),
            # Build compiler from source instead of using prebuilt binaries.
            core.replace(before = "build_setting_default = False,  # use_local_compiler", after = "build_setting_default = True,  # use_local_compiler", paths = glob(["bzl/valdi/BUILD.bazel"])),
            # Restore original author for commits imported from the public repo.
            # metadata.save_author() in the inbound workflows embeds the external author
            # as a Copybara-original-author label; restore_author reads it back and sets
            # the git author field, then strips the label from the message.
            metadata.restore_author(),
            message_transform,
        ],
        mode = mode,
    )


# Production workflows
create_workflow("default", productionRepoUrl)
create_workflow("initial_import", productionRepoUrl, "initial", "SQUASH", "Initial open source release.")

# Staging workflows
create_workflow("staging", stagingRepoUrl)
create_workflow("staging_initial_import", stagingRepoUrl, "initial", "SQUASH", "Initial open source release.")

core.workflow(
    name = "stage_public_pull_request",
    origin = git.github_pr_origin( 
        # must be literal github.com pr
        url = productionRepoUrl,
    ),
    destination = git.destination(
        url = internalRepoUrl,
        fetch = "master",
        push = "valdi_github_" + str(datetime.now().in_epoch_seconds())
    ),
    reversible_check = False,
    origin_files = publicRepoUrlFiles,
    # For AppSec reviewers:
    #   1. Ensure that we are only copying files that are intended (within open_source folder)
    #   2. Ensure that files that may contain proprietary information are omitted
    destination_files = glob(["client/src/open_source/**"],
        exclude=[
            # Don't include mirror scripts in the destination.
            "client/src/open_source/scripts/mirroring/**",
            "client/src/open_source/.gitignore",
            "client/src/open_source/.gitattributes",
            "client/src/open_source/README.md",
        ]),
    authoring = authoring.pass_thru(default = "SnapCI <snapci@snapchat.com>"),
    transformations = [
        core.move(".gitignore", ".gitignore.copybara", overwrite=True),
        core.move(".gitattributes", ".gitattributes.copybara", overwrite=True),
        core.move("README.md", "README.copybara", overwrite=True),
        core.move("bzl/additional_dependencies.bzl", "bzl/additional_dependencies.bzl.copybara", overwrite=True),
        core.move("bzl/open_source_archives.bzl", "bzl/open_source_archives.bzl.copybara", overwrite=True),
        core.replace(before = "INTERNAL_BUILD = False", after = "INTERNAL_BUILD = True", paths =  glob(["bzl/prebuilt_tools.bzl"])),
        core.replace(before = "build_setting_default = True,  # use_local_compiler", after = "build_setting_default = False,  # use_local_compiler", paths = glob(["bzl/valdi/BUILD.bazel"])),
        core.move("", internalRepoRoot),
        # Save the external contributor's author identity so the outbound mirror can
        # restore it as the git author field on the mirrored commit.
        metadata.save_author(),
    ],
    mode = "CHANGE_REQUEST",
)

core.workflow(
    name = "stage_staging_pull_request",
    origin = git.github_pr_origin( 
        # must be literal github.com pr
        url = stagingRepoUrl,
    ),
    destination = git.destination(
        url = internalRepoUrl,
        fetch = "master",
        push = "valdi_staging_" + str(datetime.now().in_epoch_seconds())
    ),
    reversible_check = False,
    origin_files = publicRepoUrlFiles,
    # For AppSec reviewers:
    #   1. Ensure that we are only copying files that are intended (within open_source folder)
    #   2. Ensure that files that may contain proprietary information are omitted
    destination_files = glob(["client/src/open_source/**"],
        exclude=[
            # Don't include mirror scripts in the destination.
            "client/src/open_source/scripts/mirroring/**",
            "client/src/open_source/.gitignore",
            "client/src/open_source/.gitattributes",
            "client/src/open_source/README.md",
        ]),
    authoring = authoring.pass_thru(default = "SnapCI <snapci@snapchat.com>"),
    transformations = [
        core.move(".gitignore", ".gitignore.copybara", overwrite=True),
        core.move(".gitattributes", ".gitattributes.copybara", overwrite=True),
        core.move("README.md", "README.copybara", overwrite=True),
        core.move("bzl/additional_dependencies.bzl", "bzl/additional_dependencies.bzl.copybara", overwrite=True),
        core.move("bzl/open_source_archives.bzl", "bzl/open_source_archives.bzl.copybara", overwrite=True),
        core.replace(before = "INTERNAL_BUILD = False", after = "INTERNAL_BUILD = True", paths =  glob(["bzl/prebuilt_tools.bzl"])),
        core.replace(before = "build_setting_default = True,  # use_local_compiler", after = "build_setting_default = False,  # use_local_compiler", paths = glob(["bzl/valdi/BUILD.bazel"])),
        core.move("", internalRepoRoot),
        # Save the external contributor's author identity so the outbound mirror can
        # restore it as the git author field on the mirrored commit.
        metadata.save_author(),
    ],
    mode = "CHANGE_REQUEST",
)
